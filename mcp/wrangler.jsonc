{
  "name": "loci-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Needed so the OAuth library may fetch a connecting app's public client metadata.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // No id on purpose: the first deploy creates this namespace and remembers it
  // (wrangler 4 does that for a binding without an id).
  "kv_namespaces": [{ "binding": "OAUTH_KV" }]
  // Settings that name the owner (email, uid, zone) are secrets, not committed
  // here: see docs/mcp-connector.md.
}
